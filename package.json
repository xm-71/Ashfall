{
  "name": "ashfall-vvardenfell",
  "private": true,
  "version": "0.1.0",
  "description": "A fully procedural, first-person Morrowind-inspired roguelike built with Three.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "assets": "npm install --prefix tools/assets --no-audit --no-fund --loglevel=error && node tools/assets/build.mjs",
    "assets:review": "npm install --prefix tools/assets --no-audit --no-fund --loglevel=error && node tools/assets/review.mjs",
    "workbench": "vite --open /workbench.html"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "vite": "^8.3.1"
  }
}
